# Copy to .env and replace both placeholders before starting.
POSTGRES_USER=gpc
POSTGRES_PASSWORD=replace_with_random_hex_password
POSTGRES_DB=gpc_dev
POSTGRES_PORT=5433
DATABASE_URL=postgresql://gpc:replace_with_random_hex_password@127.0.0.1:5433/gpc_dev
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_random_secret
# Optional dedicated test database on Compose profile test (never use the dev DB).
TEST_DATABASE_URL=postgresql://gpc:replace_with_random_hex_password@127.0.0.1:5434/gpc_test
