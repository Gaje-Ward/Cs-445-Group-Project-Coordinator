generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(cuid())
  name           String          @db.VarChar(80)
  email          String          @unique @db.VarChar(254)
  passwordHash   String
  isAdmin        Boolean         @default(false)
  isActive       Boolean         @default(true)
  sessionVersion Int             @default(0)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)
  memberships    ProjectMember[]
  uploads        ProjectFile[]
  comments       Comment[]
  ideas          Idea[]
}

enum ProjectRole {
  OWNER
  MEMBER
}

model Project {
  id          String          @id @default(cuid())
  name        String          @db.VarChar(120)
  description String?         @db.VarChar(2000)
  deadline    DateTime?       @db.Date
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)
  memberships ProjectMember[]
  tasks       Task[]
  files       ProjectFile[]
  comments    Comment[]
  ideas       Idea[]
}

model ProjectMember {
  votes         IdeaVote[]
  projectId     String
  userId        String
  role          ProjectRole @default(MEMBER)
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignedTasks Task[]      @relation("TaskAssignee")

  @@id([projectId, userId])
  @@index([userId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Task {
  id                String         @id @default(cuid())
  projectId         String
  title             String         @db.VarChar(160)
  description       String?        @db.VarChar(4000)
  status            TaskStatus     @default(TODO)
  dueDate           DateTime?      @db.Date
  assigneeProjectId String?
  assigneeId        String?
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee          ProjectMember? @relation("TaskAssignee", fields: [assigneeProjectId, assigneeId], references: [projectId, userId], onDelete: SetNull)

  @@index([projectId, status, dueDate])
  @@index([assigneeProjectId, assigneeId])
}

enum FileState {
  PENDING
  READY
  DELETING
}

model ProjectFile {
  id         String    @id @default(cuid())
  projectId  String
  uploaderId String?
  name       String    @db.VarChar(180)
  mediaType  String    @db.VarChar(100)
  size       Int
  data       Bytes?
  storageKey String?   @unique
  state      FileState @default(READY)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader   User?     @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([uploaderId])
}

enum DeletedKind {
  PROJECT
  FILE
}

model DeletionRecord {
  id          String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  kind        DeletedKind
  sourceId    String
  name        String      @db.VarChar(180)
  projectId   String
  projectName String?     @db.VarChar(120)
  deletedAt   DateTime    @default(now()) @db.Timestamptz(3)

  @@unique([kind, sourceId])
  @@index([deletedAt, id])
}

model Comment {
  id        String   @id @default(cuid())
  projectId String
  authorId  String?
  body      String   @db.VarChar(4000)
  version   Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt, id])
  @@index([authorId])
}

model Idea {
  id        String     @id @default(cuid())
  projectId String
  authorId  String?
  title     String     @db.VarChar(120)
  body      String     @db.VarChar(4000)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  votes     IdeaVote[]

  @@unique([projectId, id])
  @@index([projectId, createdAt, id])
  @@index([authorId])
}

model IdeaVote {
  projectId String
  ideaId    String
  userId    String
  idea      Idea          @relation(fields: [projectId, ideaId], references: [projectId, id], onDelete: Cascade)
  member    ProjectMember @relation(fields: [projectId, userId], references: [projectId, userId], onDelete: Cascade)

  @@id([ideaId, userId])
  @@index([projectId, userId])
}
