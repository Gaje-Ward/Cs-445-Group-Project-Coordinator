generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String          @id @default(cuid())
  name         String          @db.VarChar(80)
  email        String          @unique @db.VarChar(254)
  passwordHash String
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)
  memberships  ProjectMember[]
  uploads      ProjectFile[]
}

enum ProjectRole {
  OWNER
  MEMBER
}

model Project {
  id          String          @id @default(cuid())
  name        String          @db.VarChar(120)
  description String?         @db.VarChar(2000)
  deadline    DateTime?       @db.Date
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)
  memberships ProjectMember[]
  tasks       Task[]
  files       ProjectFile[]
}

model ProjectMember {
  projectId     String
  userId        String
  role          ProjectRole @default(MEMBER)
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignedTasks Task[]      @relation("TaskAssignee")

  @@id([projectId, userId])
  @@index([userId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Task {
  id                String         @id @default(cuid())
  projectId         String
  title             String         @db.VarChar(160)
  description       String?        @db.VarChar(4000)
  status            TaskStatus     @default(TODO)
  dueDate           DateTime?      @db.Date
  assigneeProjectId String?
  assigneeId        String?
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee          ProjectMember? @relation("TaskAssignee", fields: [assigneeProjectId, assigneeId], references: [projectId, userId], onDelete: SetNull)

  @@index([projectId, status, dueDate])
  @@index([assigneeProjectId, assigneeId])
}

enum FileState {
  PENDING
  READY
  DELETING
}

model ProjectFile {
  id         String    @id @default(cuid())
  projectId  String
  uploaderId String?
  name       String    @db.VarChar(180)
  mediaType  String    @db.VarChar(100)
  size       Int
  data       Bytes?
  storageKey String?   @unique
  state      FileState @default(READY)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader   User?     @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([uploaderId])
}
